{
  "name": "capital-hobby-group",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "predev": "node ./scripts/clean-dev.mjs",
    "dev": "npm run db:generate && turbo run dev --filter=@capital-hobby/tcg-hobby --filter=@tcg-hobby/admin --filter=@tcg-hobby/api",
    "dev:all": "npm run db:generate && turbo run dev",
    "dev:corporate": "npm run dev -w @tcg-hobby/corporate",
    "dev:tcg-hobby": "npm run dev -w @capital-hobby/tcg-hobby",
    "dev:iron-sprue": "npm run dev -w @capital-hobby/iron-sprue",
    "dev:admin": "npm run dev -w @tcg-hobby/admin",
    "dev:iron-sprue-admin:tunnel": "railway connect Postgres --tunnel-only -P 64843",
    "dev:api": "npm run dev -w @tcg-hobby/api",
    "dev:mobile": "npm run dev -w @tcg-hobby/mobile",
    "build:tcg-hobby": "npm run build -w @capital-hobby/tcg-hobby",
    "build:iron-sprue": "npm run build -w @capital-hobby/iron-sprue",
    "test:tcg-hobby": "npm run test -w @capital-hobby/tcg-hobby",
    "test:iron-sprue": "npm run test -w @capital-hobby/iron-sprue",
    "cloudflare:build:tcg-hobby": "npm run cloudflare:build -w @capital-hobby/tcg-hobby",
    "cloudflare:preview:tcg-hobby": "npm run cloudflare:preview -w @capital-hobby/tcg-hobby",
    "cloudflare:dry-run:tcg-hobby": "npm run cloudflare:dry-run -w @capital-hobby/tcg-hobby",
    "cloudflare:build:iron-sprue": "npm run cloudflare:build -w @capital-hobby/iron-sprue",
    "cloudflare:deploy:iron-sprue": "npm run cloudflare:deploy -w @capital-hobby/iron-sprue",
    "cloudflare:preview:iron-sprue": "npm run cloudflare:preview -w @capital-hobby/iron-sprue",
    "cloudflare:dry-run:iron-sprue": "npm run cloudflare:dry-run -w @capital-hobby/iron-sprue",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @tcg-hobby/database",
    "db:migrate": "npm run db:migrate -w @tcg-hobby/database",
    "db:seed": "npm run db:seed -w @tcg-hobby/database",
    "db:status": "npm run db:status -w @tcg-hobby/database",
    "db:verify": "npm run db:verify -w @tcg-hobby/database",
    "product:validate": "tsx scripts/product-import.ts validate",
    "product:dry-run": "tsx scripts/product-import.ts dry-run",
    "product:import": "tsx scripts/product-import.ts import",
    "product:import:all": "tsx scripts/product-import.ts import-all",
    "iron-sprue:content-cleanup": "node --import tsx scripts/iron-sprue-content-cleanup.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3"
  }
}
