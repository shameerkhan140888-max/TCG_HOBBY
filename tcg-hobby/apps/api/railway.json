{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build -w @capital-hobby/database && npm run build -w @capital-hobby/api"
  },
  "deploy": {
    "startCommand": "npm run start -w @capital-hobby/api",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
