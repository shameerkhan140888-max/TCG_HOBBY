{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run db:generate && npm run build -w @tcg-hobby/admin"
  },
  "deploy": {
    "startCommand": "npm run start -w @tcg-hobby/admin",
    "healthcheckPath": "/iron-sprue-admin/login",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
