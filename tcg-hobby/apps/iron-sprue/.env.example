# Iron Sprue local environment names only. Do not commit real values.

IRON_SPRUE_ENVIRONMENT=development
IRON_SPRUE_STORE_ID=IRON_SPRUE

# Dedicated Iron Sprue Neon project.
IRON_SPRUE_DATABASE_URL=
IRON_SPRUE_DIRECT_DATABASE_URL=
IRON_SPRUE_WORKER_READ_DATABASE_URL=

# Dedicated Iron Sprue R2 product-media bucket.
IRON_SPRUE_R2_ACCOUNT_ID=
IRON_SPRUE_R2_BUCKET_NAME=iron-sprue-product-media
IRON_SPRUE_R2_ACCESS_KEY_ID=
IRON_SPRUE_R2_SECRET_ACCESS_KEY=
IRON_SPRUE_R2_ENDPOINT=
IRON_SPRUE_R2_REGION=auto
IRON_SPRUE_R2_PUBLIC_BASE_URL=
IRON_SPRUE_R2_UPLOAD_PREFIX=products/

# Storefront/Admin URLs used for CORS and local routing.
IRON_SPRUE_SITE_URL=http://localhost:3002
IRON_SPRUE_ADMIN_URL=http://localhost:3001
