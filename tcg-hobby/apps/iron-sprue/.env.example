# Iron Sprue local environment names only. Do not commit real values.

IRON_SPRUE_ENVIRONMENT=development
IRON_SPRUE_STORE_ID=IRON_SPRUE

# Dedicated Iron Sprue Neon project.
IRON_SPRUE_DATABASE_URL=
IRON_SPRUE_DIRECT_DATABASE_URL=
IRON_SPRUE_WORKER_READ_DATABASE_URL=

# Dedicated Iron Sprue R2 product-media bucket.
IRON_SPRUE_R2_ACCOUNT_ID=
IRON_SPRUE_R2_BUCKET_NAME=iron-sprue-product-media
IRON_SPRUE_R2_ACCESS_KEY_ID=
IRON_SPRUE_R2_SECRET_ACCESS_KEY=
IRON_SPRUE_R2_ENDPOINT=
IRON_SPRUE_R2_REGION=auto
IRON_SPRUE_R2_PUBLIC_BASE_URL=
IRON_SPRUE_R2_UPLOAD_PREFIX=products/

# Storefront/Admin URLs used for CORS and local routing.
IRON_SPRUE_SITE_URL=http://localhost:3004
IRON_SPRUE_ADMIN_URL=http://localhost:3001

# Iron Sprue API proxy used by the storefront for server-side mutations.
IRON_SPRUE_NODE_API_ORIGIN=http://localhost:4000
IRON_SPRUE_INTERNAL_API_KEY_ID=
IRON_SPRUE_INTERNAL_API_SECRET=

# Iron Sprue Stripe payment integration.
# Use Stripe test-mode values locally. The webhook secret from `stripe listen`
# is different from a Dashboard-created webhook endpoint secret.
IRON_SPRUE_STRIPE_ACCOUNT_ID=
IRON_SPRUE_STRIPE_TEST_SECRET_KEY=
IRON_SPRUE_STRIPE_TEST_WEBHOOK_SECRET=
IRON_SPRUE_STRIPE_TEST_PUBLISHABLE_KEY=
IRON_SPRUE_STRIPE_LIVE_SECRET_KEY=
IRON_SPRUE_STRIPE_LIVE_WEBHOOK_SECRET=
IRON_SPRUE_STRIPE_LIVE_PUBLISHABLE_KEY=
IRON_SPRUE_STRIPE_STATEMENT_DESCRIPTOR=IRON SPRUE
IRON_SPRUE_STRIPE_PUBLIC_BUSINESS_NAME=Iron Sprue
IRON_SPRUE_CHECKOUT_SUCCESS_URL=http://localhost:3004/checkout/success?session_id={CHECKOUT_SESSION_ID}
IRON_SPRUE_CHECKOUT_CANCEL_URL=http://localhost:3004/checkout/cancel

# Iron Sprue transactional email.
# Use an Iron Sprue sender identity only; do not fall back to TCG Hobby email settings.
IRON_SPRUE_RESEND_API_KEY=
IRON_SPRUE_EMAIL_FROM="Iron Sprue <orders@ironsprue.co.uk>"
IRON_SPRUE_EMAIL_REPLY_TO=info@ironsprue.co.uk
IRON_SPRUE_SUPPORT_EMAIL=info@ironsprue.co.uk
# Use public HTTPS URLs that email clients can fetch. Localhost assets will not render in customer inboxes.
IRON_SPRUE_EMAIL_ASSET_BASE_URL=https://www.ironsprue.co.uk
IRON_SPRUE_EMAIL_LOGO_URL=https://www.ironsprue.co.uk/brand/iron-sprue-horizontal-email.png

# Iron Sprue analytics and marketing tags.
# Optional IDs are loaded only after the customer grants analytics/marketing consent.
NEXT_PUBLIC_IRON_SPRUE_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_IRON_SPRUE_META_PIXEL_ID=
NEXT_PUBLIC_IRON_SPRUE_SEARCH_CONSOLE_VERIFICATION=
NEXT_PUBLIC_IRON_SPRUE_META_DOMAIN_VERIFICATION=
