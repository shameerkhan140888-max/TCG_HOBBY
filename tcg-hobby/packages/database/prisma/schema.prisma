generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserSecurityTokenType {
  PASSWORD_RESET
}

enum ProductCondition {
  MINT
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
  SEALED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum FulfilmentStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  CANCELLED
}

enum PricingRuleType {
  MANUAL
  COST_PLUS_PERCENT
  FIXED_MARGIN
  SUPPLIER_COST
  PROMOTIONAL
  FUTURE_MARKET_FEED
}

enum PricingRuleScope {
  GLOBAL
  PRODUCT
  CATEGORY
  SUPPLIER
}

enum PriceStatus {
  ACTIVE
  MANUAL_OVERRIDE
  DISABLED
  FUTURE
}

enum BuylistStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum ProductReleaseStatus {
  RELEASED
  PREORDER
  COMING_SOON
  ARCHIVED
}

enum ProductRecommendationType {
  RELATED
  ACCESSORY
  UPSELL
  CROSS_SELL
  MANUAL
}

enum NotificationPreference {
  ALL
  PREORDER
  RELEASE
}

enum NotificationType {
  PRICE_MOVEMENT
  UPCOMING_RELEASE
  WISHLIST_AVAILABILITY
  COLLECTION_UPDATES
  BUYLIST_UPDATES
}

enum MarketingSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  SUPPRESSED
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum WatchlistSubjectType {
  PRODUCT
  RELEASE
  COLLECTION_ITEM
}

enum MarketTrend {
  UP
  DOWN
  FLAT
  VOLATILE
}

enum CollectionPrintVariant {
  REGULAR
  REVERSE_HOLO
  HOLO
  PROMO
  FIRST_EDITION
  FOIL
}

enum DeckVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole   @default(CUSTOMER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  wishlist      Wishlist?
  buylists      Buylist[]
  collection    Collection?
  decks         Deck[]
  notificationSubscriptions NotificationSubscription[]
  watchlist     WatchlistItem[]
  notificationPreferences NotificationCenterPreference[]
  collectionInsightSnapshot CollectionInsightSnapshot?
  marketingSubscribers MarketingSubscriber[]
  marketingCampaigns MarketingCampaign[]
  securityTokens UserSecurityToken[]
  ironSprueWishlistItems IronSprueWishlistItem[]
  roleChangesReceived AdminRoleChange[] @relation("RoleChangesForUser")
  roleChangesMade AdminRoleChange[] @relation("RoleChangesByUser")
}

model UserSecurityToken {
  id        String                @id @default(cuid())
  userId    String
  type      UserSecurityTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt, usedAt])
}

model AdminRoleChange {
  id              String   @id @default(cuid())
  userId          String
  previousRole    UserRole
  newRole         UserRole
  changedByUserId String?
  source          String
  createdAt       DateTime @default(now())
  user            User     @relation("RoleChangesForUser", fields: [userId], references: [id], onDelete: Restrict)
  changedBy       User?    @relation("RoleChangesByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([changedByUserId, createdAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String?
  fullName     String
  email        String
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String
  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")

  @@index([userId, country])
  @@index([postalCode, city])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  sortOrder   Int       @default(0)
  imageLabel  String
  products    Product[]
  pricingRules PricingRule[]
  releases    Release[]
}

model Game {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  products    Product[]
  sets        ProductSet[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, sortOrder])
  @@index([name])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  website     String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([name])
}

model ProductType {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  group       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([group])
  @@index([name])
}

model ProductLanguage {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([name])
}

model ProductSet {
  id          String    @id @default(cuid())
  name        String
  slug        String
  gameId      String
  releaseDate DateTime?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Restrict)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([gameId, slug])
  @@index([gameId, active, sortOrder])
  @@index([name])
}

model Supplier {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  contactName     String?
  email           String?
  phone           String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String            @default("GB")
  preferred       Boolean           @default(false)
  internalNotes   String?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  supplierProducts SupplierProduct[]
  pricingRules    PricingRule[]
}

model Product {
  id            String           @id @default(cuid())
  importId      String?          @unique
  sku           String           @unique
  barcode       String?          @unique
  slug          String           @unique
  name          String
  brand         String?
  game          String
  setName       String?
  productType   String?
  language      String?
  gameId        String?
  brandId       String?
  productTypeId String?
  languageId    String?
  setId         String?
  description   String
  longDescription String
  condition     ProductCondition @default(SEALED)
  priceMinor    Int
  rrpMinor      Int?
  salePriceMinor Int?
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  vatRate       Int              @default(20)
  currency      String           @default("GBP")
  featured      Boolean          @default(false)
  homepagePriority Int?
  heroFeatured Boolean           @default(false)
  recommendationWeight Int       @default(0)
  isAccessory   Boolean          @default(false)
  isStaffPick   Boolean          @default(false)
  isBestSeller  Boolean          @default(false)
  isNewArrival  Boolean          @default(false)
  freeUkStandardShipping Boolean @default(false)
  shippingPromotionProductOnly Boolean @default(true)
  lifecycleState String          @default("DRAFT")
  published     Boolean          @default(true)
  hideWhenOutOfStock Boolean     @default(false)
  archivedAt    DateTime?
  searchText    String
  searchTags    String[]         @default([])
  productHighlights String[]     @default([])
  specificationSummary String?
  verifiedContents String[]      @default([])
  imageLabel    String
  releaseStatus ProductReleaseStatus @default(RELEASED)
  releaseDate   DateTime?
  expectedDispatchAt DateTime?
  expectedArrivalAt DateTime?
  allocationLimit Int?
  customerPurchaseLimit Int?
  supplierAllocation Int?
  lowAllocationThreshold Int?
  availabilityMessage String?
  preorderBadgeLabel String?
  comingSoonBadgeLabel String?
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  gameRef       Game?            @relation(fields: [gameId], references: [id], onDelete: Restrict)
  brandRef      Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productTypeRef ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  languageRef   ProductLanguage? @relation(fields: [languageId], references: [id], onDelete: Restrict)
  setRef        ProductSet?      @relation(fields: [setId], references: [id], onDelete: Restrict)
  inventory     InventoryItem?
  images        ProductImage[]
  facts         ProductFact[]
  contentGenerations ProductContentGeneration[]
  imageCleanupTasks ProductImageCleanup[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  supplierProducts SupplierProduct[]
  stockAdjustments StockAdjustment[]
  pricing      ProductPricing?
  buylistItems  BuylistItem[]
  collectionItems CollectionItem[]
  deckCards     DeckCard[]
  pricingRules  PricingRule[]
  releaseProducts ReleaseProduct[]
  notificationSubscriptions NotificationSubscription[]
  marketSnapshots MarketSnapshot[]
  watchlistItems WatchlistItem[]
  recommendationsFrom ProductRecommendation[] @relation("ProductRecommendationSource")
  recommendationsTo   ProductRecommendation[] @relation("ProductRecommendationTarget")
  heroPlacements HomepageHeroPlacement[]
  importSourceType String?
  importSourceReference String?
  importedAt     DateTime?
  lastImportedAt DateTime?
  importValidationWarnings String?
  seoTitle      String?
  metaDescription String?
  canonicalUrl  String?
  ogImageUrl    String?
  noindex       Boolean          @default(false)
  importAudits   ProductImportAudit[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([importId])
  @@index([slug, published])
  @@index([categoryId, published])
  @@index([archivedAt, published])
  @@index([published, featured])
  @@index([published, featured, homepagePriority])
  @@index([published, recommendationWeight])
  @@index([published, isAccessory])
  @@index([published, isStaffPick])
  @@index([published, isBestSeller])
  @@index([published, isNewArrival])
  @@index([published, heroFeatured])
  @@index([lifecycleState, published])
  @@index([releaseStatus, releaseDate])
  @@index([published, releaseStatus])
  @@index([published, hideWhenOutOfStock])
  @@index([name])
  @@index([barcode])
  @@index([brand])
  @@index([productType])
  @@index([gameId])
  @@index([brandId])
  @@index([productTypeId])
  @@index([languageId])
  @@index([setId])
  @@index([searchText])
}

model ProductRecommendation {
  id                   String                    @id @default(cuid())
  sourceProductId      String
  recommendedProductId String
  relationshipType     ProductRecommendationType @default(RELATED)
  priority             Int                       @default(100)
  active               Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  sourceProduct        Product                   @relation("ProductRecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  recommendedProduct   Product                   @relation("ProductRecommendationTarget", fields: [recommendedProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, recommendedProductId, relationshipType], map: "ProductRecommendation_sourceProductId_recommendedProductId_rela")
  @@index([sourceProductId, active, priority])
  @@index([recommendedProductId])
  @@index([relationshipType, active])
}

model ProductImportAudit {
  id             String   @id @default(cuid())
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  importId       String?
  sourceType     String
  sourceReference String?
  lifecycleState String
  changedFields  Json
  previousValues Json?
  nextValues     Json?
  warnings       String?
  performedBy    String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([importId])
  @@index([createdAt])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  thumbnailUrl String?
  storageKey String? @unique
  storageProvider String?
  altText    String
  imageType  String   @default("gallery")
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  width      Int?
  height     Int?
  mimeType   String?
  byteSize   Int?
  uploadedById String?
  deletionState String @default("ACTIVE")
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  heroPlacements HomepageHeroPlacement[] @relation("HeroSelectedProductImage")

  @@index([productId, deletionState, isPrimary, sortOrder])
  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
}

model ProductFact {
  id                String    @id @default(cuid())
  productId         String
  key               String
  value             String
  valueType         String    @default("TEXT")
  verificationState String    @default("UNVERIFIED")
  sourceReference   String?
  notes             String?
  sortOrder         Int       @default(0)
  verifiedAt        DateTime?
  verifiedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId, verificationState, sortOrder])
}

model ProductContentGeneration {
  id               String    @id @default(cuid())
  productId        String
  requestedById    String
  provider         String
  model            String
  status           String    @default("DRAFT")
  requestedFields  Json
  generatedContent Json
  warnings         Json
  appliedFields    Json?
  previousValues   Json?
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([requestedById, createdAt])
}

model ProductImageCleanup {
  id          String    @id @default(cuid())
  productId   String
  imageId     String?
  objectKey   String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId, status])
}

model Release {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  brand            String
  game             String
  categoryId       String
  releaseDate      DateTime
  expectedDispatchAt DateTime?
  expectedArrivalAt DateTime?
  announcementText String?
  releaseNotes     String?
  visible          Boolean         @default(true)
  featuredOnHomepage Boolean        @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products         ReleaseProduct[]
  watchlistItems   WatchlistItem[]

  @@index([releaseDate, visible])
  @@index([featuredOnHomepage, visible])
  @@index([categoryId, releaseDate])
  @@index([brand, releaseDate])
}

model ReleaseProduct {
  id                  String               @id @default(cuid())
  releaseId           String
  productId           String
  status              ProductReleaseStatus @default(COMING_SOON)
  releaseDate         DateTime?
  expectedDispatchAt  DateTime?
  expectedArrivalAt   DateTime?
  allocationLimit     Int?
  customerPurchaseLimit Int?
  supplierAllocation  Int?
  allocatedQuantity   Int                  @default(0)
  lowAllocationThreshold Int?
  availabilityMessage  String?
  preorderBadgeLabel   String?
  comingSoonBadgeLabel String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  release             Release              @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([releaseId, productId])
  @@index([productId, status])
  @@index([releaseId, status])
  @@index([releaseDate, status])
  @@index([releaseId, productId])
}

model NotificationSubscription {
  id            String                @id @default(cuid())
  userId        String
  productId     String
  preference    NotificationPreference @default(ALL)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([userId, preference])
}

model NotificationCenterPreference {
  id              String              @id @default(cuid())
  userId          String
  notificationType NotificationType
  subjectType     WatchlistSubjectType?
  subjectLabel    String?
  emailEnabled    Boolean             @default(true)
  pushEnabled     Boolean             @default(false)
  inAppEnabled    Boolean             @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, subjectType, subjectLabel])
  @@index([userId, notificationType])
  @@index([notificationType, emailEnabled])
}

model MarketingSubscriber {
  id                              String                    @id @default(cuid())
  email                           String                    @unique
  firstName                       String?
  marketingConsent                Boolean                   @default(false)
  marketingConsentAt              DateTime?
  consentSource                   String?
  privacyPolicyVersion            String?
  consentIpHash                   String?
  source                          String                    @default("storefront")
  lastUpdatedSource               String?
  status                          MarketingSubscriberStatus @default(ACTIVE)
  customerId                      String?
  unsubscribeToken                String                    @unique
  lastSignupAt                    DateTime                  @default(now())
  confirmationEmailSentAt         DateTime?
  confirmationEmailLastAttemptAt  DateTime?
  confirmationEmailError          String?
  lastEmailSentAt                 DateTime?
  bouncedAt                       DateTime?
  suppressedAt                    DateTime?
  unsubscribedAt                  DateTime?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  customer                        User?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tags                            MarketingSubscriberTagAssignment[]

  @@index([status, marketingConsent])
  @@index([source, createdAt])
  @@index([lastSignupAt])
  @@index([customerId])
  @@index([unsubscribedAt])
}

model MarketingSubscriberTag {
  id          String                              @id @default(cuid())
  slug        String                              @unique
  label       String
  description String?
  createdAt   DateTime                            @default(now())
  updatedAt   DateTime                            @updatedAt
  subscribers MarketingSubscriberTagAssignment[]

  @@index([label])
}

model MarketingSubscriberTagAssignment {
  subscriberId String
  tagId        String
  createdAt    DateTime              @default(now())
  subscriber   MarketingSubscriber   @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tag          MarketingSubscriberTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagId])
  @@index([tagId])
}

model MarketingCampaign {
  id                 String                  @id @default(cuid())
  name               String
  subject            String
  previewText        String?
  status             MarketingCampaignStatus @default(DRAFT)
  audienceDefinition Json
  createdById        String?
  scheduledAt        DateTime?
  sentAt             DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdBy          User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([scheduledAt])
  @@index([createdById])
}

model MarketSnapshot {
  id                  String          @id @default(cuid())
  productId           String          @unique
  currentEstimateMinor Int
  yesterdayMinor      Int
  sevenDayMinor       Int
  thirtyDayMinor      Int
  trend               MarketTrend
  confidenceScore     Int
  lastUpdatedAt       DateTime
  source              String
  currency            String          @default("GBP")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  history             MarketPriceHistory[]
  watchlistItems      WatchlistItem[]

  @@index([trend, lastUpdatedAt])
  @@index([confidenceScore, lastUpdatedAt])
  @@index([source, lastUpdatedAt])
}

model MarketPriceHistory {
  id            String         @id @default(cuid())
  snapshotId    String
  label         String
  valueMinor    Int
  recordedAt    DateTime
  createdAt     DateTime       @default(now())
  snapshot      MarketSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, recordedAt])
  @@index([label, recordedAt])
}

model WatchlistItem {
  id                 String              @id @default(cuid())
  userId             String
  subjectType        WatchlistSubjectType
  subjectKey         String
  productId          String?
  releaseId          String?
  collectionItemId   String?
  marketSnapshotId   String?
  notificationType   NotificationType    @default(PRICE_MOVEMENT)
  emailEnabled       Boolean             @default(true)
  pushEnabled        Boolean             @default(false)
  inAppEnabled       Boolean             @default(true)
  note               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  release            Release?            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  collectionItem     CollectionItem?     @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  marketSnapshot     MarketSnapshot?     @relation(fields: [marketSnapshotId], references: [id], onDelete: SetNull)

  @@unique([userId, subjectType, subjectKey])
  @@index([userId, notificationType])
  @@index([productId, createdAt])
  @@index([releaseId, createdAt])
  @@index([collectionItemId, createdAt])
  @@index([marketSnapshotId, createdAt])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
